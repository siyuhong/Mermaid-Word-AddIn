# Word on the web embeds the task pane. Do not add X-Frame-Options or
# a frame-ancestors policy that prevents Office from embedding this site.
/*
  X-Content-Type-Options: nosniff

# Entry points must be revalidated so Word discovers the hashed bundles.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache

# Webpack emits content-hashed script names in production builds.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/manifest.xml
  Content-Type: application/xml; charset=utf-8
  Content-Disposition: attachment; filename="manifest.xml"
  Cache-Control: no-cache

# Static icons keep their names; use a shorter TTL so updates still propagate.
/assets/*
  Cache-Control: public, max-age=86400
